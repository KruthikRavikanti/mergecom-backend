# syntax=docker/dockerfile:1.7

FROM node:24.18.1-bookworm-slim AS build
WORKDIR /workspace
RUN npm install --global pnpm@11.22.0
COPY .npmrc package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json turbo.json ./
COPY apps/office-addin/package.json apps/office-addin/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/office-core/package.json packages/office-core/package.json
COPY packages/test-fixtures/package.json packages/test-fixtures/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY services/api/package.json services/api/package.json
COPY services/worker/package.json services/worker/package.json
COPY services/rendition-engine/package.json services/rendition-engine/package.json
RUN pnpm install --frozen-lockfile
COPY services/rendition-engine services/rendition-engine
RUN pnpm --filter @mergecom/rendition-engine build \
    && pnpm --filter @mergecom/rendition-engine deploy --prod --legacy /opt/mergecom

FROM node:24.18.1-bookworm-slim AS runtime
LABEL org.opencontainers.image.source="https://github.com/KruthikRavikanti/mergecom-backend"
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
      fonts-liberation2 \
      fonts-noto-core \
      libreoffice-calc \
      libreoffice-impress \
      libreoffice-writer \
      qpdf \
    && rm -rf /var/lib/apt/lists/* \
    && fc-cache -f
ENV HOME=/tmp/mergecom-home \
    NODE_ENV=production \
    RENDITION_ENGINE_HOST=0.0.0.0 \
    RENDITION_ENGINE_PORT=3004 \
    RENDITION_FONT_PACK_VERSION=mergecom-liberation-noto-v1 \
    RENDITION_RENDERER_PROFILE=office-pdf-v1 \
    RENDITION_RENDERER_VERSION=libreoffice-bookworm-v1 \
    RENDITION_TEMP_ROOT=/tmp/mergecom-rendition
WORKDIR /app
COPY --from=build --chown=node:node /opt/mergecom/node_modules ./node_modules
COPY --from=build --chown=node:node /opt/mergecom/package.json ./package.json
COPY --from=build --chown=node:node /workspace/services/rendition-engine/dist ./dist
USER node
EXPOSE 3004
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=4 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3004/health/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node", "dist/server.js"]
