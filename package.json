{
  "name": "mergecom",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.18.1",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "build": "turbo run build && pnpm build:dotnet && pnpm check:production-bundle && pnpm check:marketing-bundle && pnpm check:marketing-release",
    "build:dotnet": "dotnet build services/document-engine/MergeCom.DocumentEngine.sln --configuration Release --nologo",
    "clean": "turbo run clean && rm -rf coverage playwright-report test-results",
    "check:marketing-bundle": "node scripts/check-marketing-bundle.mjs",
    "check:marketing-release": "node scripts/check-marketing-release.mjs",
    "check:production-bundle": "node scripts/check-production-bundle.mjs",
    "dev": "concurrently --kill-others --names workspace,document-engine \"pnpm dev:workspace\" \"pnpm dev:document-engine\"",
    "dev:document-engine": "ASPNETCORE_ENVIRONMENT=Development ASPNETCORE_URLS=http://0.0.0.0:3003 dotnet watch --project services/document-engine/src/MergeCom.DocumentEngine/MergeCom.DocumentEngine.csproj run --no-launch-profile",
    "dev:workspace": "turbo run dev --parallel",
    "demo:provision": "node scripts/provision-synthetic-demo.mjs",
    "format": "prettier --write . && dotnet format services/document-engine/MergeCom.DocumentEngine.sln",
    "format:check": "prettier --check . && dotnet format services/document-engine/MergeCom.DocumentEngine.sln --verify-no-changes",
    "infra:down": "docker compose --env-file infra/compose/.env.example -f infra/compose/compose.yaml down",
    "infra:up": "docker compose --env-file infra/compose/.env.example -f infra/compose/compose.yaml up -d --wait",
    "install:check": "pnpm install --frozen-lockfile",
    "lint": "turbo run lint",
    "test:dotnet": "dotnet test services/document-engine/MergeCom.DocumentEngine.sln --configuration Release --nologo",
    "test:deployment": "node --test infra/deployment/deployment.test.mjs",
    "test:e2e": "playwright test",
    "test:integration": "turbo run test:integration",
    "test:unit": "turbo run test:unit && pnpm test:dotnet",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:deployment && pnpm test:unit && pnpm test:integration && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "concurrently": "10.0.5",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "prettier": "3.9.0",
    "turbo": "2.10.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.52.0"
  }
}
