{
  "name": "@mergecom/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "db:generate": "drizzle-kit generate",
    "db:bootstrap-owner": "tsx src/db/bootstrap-owner.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src test",
    "start": "node dist/server.js",
    "test:integration": "vitest run --no-file-parallelism test/startup.test.ts test/postgres.test.ts test/identity.postgres.test.ts test/projects.postgres.test.ts test/versions.postgres.test.ts test/notifications.postgres.test.ts",
    "test:unit": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1112.0",
    "@aws-sdk/s3-request-presigner": "3.1112.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "@sinclair/typebox": "0.34.52",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.0",
    "nodemailer": "9.0.5",
    "openid-client": "6.8.5",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/nodemailer": "7.0.11",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.21.0",
    "vitest": "4.1.0"
  }
}
