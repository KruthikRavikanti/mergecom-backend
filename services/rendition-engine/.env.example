NODE_ENV=development
RENDITION_ENGINE_HOST=0.0.0.0
RENDITION_ENGINE_PORT=3004
RENDITION_ENGINE_INTERNAL_TOKEN=mergecom-local-rendition-engine-token
RENDITION_RENDERER_PROFILE=office-pdf-v1
RENDITION_RENDERER_VERSION=libreoffice-local
RENDITION_FONT_PACK_VERSION=mergecom-liberation-noto-v1
RENDITION_SOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice
RENDITION_QPDF_PATH=qpdf
RENDITION_TEMP_ROOT=/tmp/mergecom-renditions
RENDITION_MAX_INPUT_BYTES=104857600
RENDITION_MAX_OUTPUT_BYTES=209715200
RENDITION_TIMEOUT_MILLISECONDS=120000
