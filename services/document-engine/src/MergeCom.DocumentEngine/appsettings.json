{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Inspection": {
    "InternalToken": "mergecom-local-document-engine-token",
    "MaxInputBytes": 104857600,
    "MaxEntries": 5000,
