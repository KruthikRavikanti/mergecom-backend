{
  "name": "@mergecom/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src test",
    "start": "node dist/server.js",
    "test:integration": "vitest run test/startup.test.ts test/pipeline.postgres.test.ts test/notifications.postgres.test.ts",
    "test:unit": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1112.0",
    "bullmq": "6.1.2",
    "fastify": "5.12.0",
    "ioredis": "6.0.0",
    "nodemailer": "9.0.5",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/nodemailer": "7.0.11",
    "@types/pg": "8.23.1",
    "tsx": "4.21.0",
    "vitest": "4.1.0"
  }
}
