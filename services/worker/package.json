{
  "name": "@mergecom/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src test",
    "start": "node dist/server.js",
    "test:integration": "vitest run test/startup.test.ts",
    "test:unit": "vitest run src/app.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "bullmq": "5.66.5",
    "fastify": "5.12.0",
    "ioredis": "5.8.2"
  },
  "devDependencies": {
    "tsx": "4.21.0",
    "vitest": "4.0.16"
  }
}
